# Environment variables
# Copy this file to .env and fill in the values

# IBM watsonx / Bob API key
IBM_API_KEY=

# IBM watsonx project ID
IBM_PROJECT_ID=

# IBM watsonx service URL (e.g. https://us-south.ml.cloud.ibm.com)
IBM_SERVICE_URL=

# Agent model ID (e.g. ibm/granite-13b-instruct-v2)
MODEL_ID=ibm/granite-13b-instruct-v2

# Log level: debug | info | warn | error
LOG_LEVEL=info
